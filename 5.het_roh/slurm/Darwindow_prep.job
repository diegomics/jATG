#!/bin/bash

#SBATCH -J Darw.prep
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=12:00:00

export PATH="${CONDA_BIN_DIR}:${PATH}"
source activate jATG_env

cd ${OUT_DIR}/jATG/${SPECIES_NAME}/${ASSEMBLY_ID}/${SAMPLE_NAME}/5.het_roh.w${WIN_SIZE}

# Link input files
VCF_NAME=$(basename $VCF)
ln -s $VCF ${VCF_NAME}
ln -s ${VCF}.tbi ${VCF_NAME}.tbi

# Setup parameters
MYVCF=${VCF_NAME}
winsize=${WIN_SIZE}
mincontigbp=${MIN_SCAF}
suffix="allsites_roh"

# Extract header for contig information
bcftools view -h ${VCF_NAME} > myvcf.header.txt

# Extract contig information
echo "Selecting contigs with minimum length..."
grep 'contig' myvcf.header.txt | cut -f1 -d ',' | sed 's/ID=/!/g' | cut -f2 -d '!' > mycontigs.txt
grep 'contig' myvcf.header.txt | cut -f2 -d ',' | cut -f2 -d '=' | sed 's/>//g' > mylengths.txt
paste mycontigs.txt mylengths.txt > mycontiglengths.txt
rm mycontigs.txt mylengths.txt
awk -v minlength="$mincontigbp" '$2>=minlength' mycontiglengths.txt > mylongcontigs.txt
ncontigs=$(wc -l mylongcontigs.txt | cut -f1 -d ' ')
echo "Number of contigs retained: $ncontigs"

# Get sample information
bcftools query -l ${VCF_NAME} > myvcfsamples.txt
nrsamples=$(wc -l myvcfsamples.txt | cut -f1 -d ' ')
seq 1 $nrsamples > mysamplenrs.txt

# Create output header
echo "contig startbp endbp totalbp" | sed 's/ /\t/g' > header1.tmp.txt
sed 's/^/nmiss_/' mysamplenrs.txt > mysamplenrs.nmiss.tmp.txt
sed 's/^/nrefhomo_/' mysamplenrs.txt > mysamplenrs.refhomo.tmp.txt
sed 's/^/nalthomo_/' mysamplenrs.txt > mysamplenrs.althomo.tmp.txt
sed 's/^/nhet_/' mysamplenrs.txt > mysamplenrs.het.tmp.txt
sed 's/^/nmultihet_/' mysamplenrs.txt > mysamplenrs.multihet.tmp.txt

paste -d '\n' mysamplenrs.nmiss.tmp.txt mysamplenrs.refhomo.tmp.txt mysamplenrs.althomo.tmp.txt mysamplenrs.het.tmp.txt mysamplenrs.multihet.tmp.txt | tr '\n' '\t' > header2.tmp.txt
paste header1.tmp.txt header2.tmp.txt > mywindowheader.txt
rm mysamplenrs.* header?.tmp.txt

# Initialize output file
if [ -f "mywindowhe.${winsize}.${suffix}.txt" ]; then rm mywindowhe.${winsize}.${suffix}.txt; fi
cp mywindowheader.txt mywindowhe.${winsize}.${suffix}.txt

# Process each contig
echo "Starting analysis..."
for contignr in $(seq 1 $ncontigs); do
    contigname=$(awk -v myline="$contignr" 'NR==myline' mylongcontigs.txt | cut -f1)
    contiglength=$(awk -v myline="$contignr" 'NR==myline' mylongcontigs.txt | cut -f2)
    echo -e "$contignr\t$contigname\t$contiglength"
    
    contiglength2=$(( $contiglength + $winsize ))
    
    # Process each window
    for endbp in $(seq $winsize $winsize $contiglength2); do
        startbp=$(( $endbp - $winsize + 1 ))
        if (( $endbp > $contiglength )); then
            endbp=$contiglength
            winsize2=$(( $endbp - $startbp + 1 ))
        else
            winsize2=$winsize
        fi
        
        # Extract window region
        tabix ${MYVCF} ${contigname}:${startbp}-${endbp} > myvcfregion.${winsize}.allcolumns.txt
        cut -f10- myvcfregion.${winsize}.allcolumns.txt > myvcfregion.${winsize}.txt
        totalbp=$(wc -l myvcfregion.${winsize}.allcolumns.txt | cut -f1 -d ' ')
        
        # Initialize window stats
        echo -e "$contigname\t$startbp\t$endbp\t$totalbp" > mywindowhe.${winsize}.tmp.txt
        
        # Process each sample
        for indnr in $(seq 1 $nrsamples); do
            # Extract sample column
            cut -f$indnr myvcfregion.${winsize}.txt > myvcfcolumn.${winsize}.txt
            
            # Count genotypes
            # Missing sites
            missingsites=$(grep -E '\./\.|\.\|\.' myvcfcolumn.${winsize}.txt | wc -l | cut -f1 -d ' ')
            
            # Reference homozygous (0/0 or 0|0)
            refhomosites=$(grep -E '0/0|0\|0' myvcfcolumn.${winsize}.txt | wc -l | cut -f1 -d ' ')
            
            # Alternative homozygous (1/1 or 1|1)
            althomosites=$(grep -E '1/1|1\|1' myvcfcolumn.${winsize}.txt | wc -l | cut -f1 -d ' ')
            
            # Regular heterozygous (0/1 or 0|1)
            heterosites=$(grep -E '0/1|0\|1' myvcfcolumn.${winsize}.txt | wc -l | cut -f1 -d ' ')
            
            # Multi-allelic heterozygous (1/2 or 1|2)
            multihetero=$(grep -E '1/2|1\|2' myvcfcolumn.${winsize}.txt | wc -l | cut -f1 -d ' ')
            
            # Add to output
            sed -i "s/$/\t${missingsites}\t${refhomosites}\t${althomosites}\t${heterosites}\t${multihetero}/" mywindowhe.${winsize}.tmp.txt
        done
        
        # Append window results to main output
        cat mywindowhe.${winsize}.tmp.txt >> mywindowhe.${winsize}.${suffix}.txt
    done
done

# Cleanup
rm myvcf.header.txt myvcfregion.* myvcfcolumn.* mywindowhe.*.tmp.txt

echo "Analysis finished."
